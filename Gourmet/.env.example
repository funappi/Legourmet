# Copie ce fichier en ".env" (jamais committé) et renseigne ta clé.
GROQ_API_KEY=
# Origines autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=https://funappi.github.io,http://localhost:5500,http://127.0.0.1:5500
# Requêtes de génération autorisées par minute et par IP
RATE_LIMIT_PER_MIN=10
# GROQ_MODEL=llama-3.1-8b-instant
# FLASK_DEBUG=1
# HOST=0.0.0.0
